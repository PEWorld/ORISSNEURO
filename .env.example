# --- обязательное ---
# Токен от @BotFather
TELEGRAM_BOT_TOKEN=
# Ключ KIE AI (тот же, что в kie-tools/.env)
KIE_API_KEY=

# --- доступ ---
# Владельцы: полный доступ ко всем моделям и параметрам.
# Список Telegram user id через запятую.
ALLOWED_USER_IDS=

# Креаторы: только GPT Image 2 в 21:9 / 1K, без настроек и без цен.
# Кадры отправляют владельцу на согласование.
CREATOR_USER_IDS=

# Сколько картинок генерить на один промпт креатора. По умолчанию 1 — тогда
# картинка, промпт и кнопка умещаются в одно сообщение. При значении больше 1
# Telegram не даст прицепить кнопку к альбому, и она поедет отдельно.
CREATOR_GENERATIONS=1

# Куда креаторы шлют кадры на согласование.
# Пусто = первому из ALLOWED_USER_IDS.
OWNER_CHAT_ID=

# --- только для деплоя на Vercel ---
# Публичный адрес деплоя, без слэша в конце. Если задан — бот работает
# на вебхуках KIE (callBackUrl) вместо опроса статуса.
PUBLIC_URL=
# Секрет для подписи callback-ссылок KIE. Любая случайная строка.
CALLBACK_SECRET=
# Секретный токен вебхука Telegram (проверяется на входе). Любая случайная строка.
TELEGRAM_WEBHOOK_SECRET=

# --- хранилище настроек (Upstash Redis / Vercel KV) ---
# Нужно только на Vercel. Локально настройки лежат в data/state.json.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
